# Copiar a .env y rellenar. El fichero .env no se sube al repositorio.

# --- Base de datos ---------------------------------------------------------
# Sin esto se usa el SQLite del directorio del proyecto, que sirve en local
# pero no en un despliegue serverless: allí hay que apuntar a un Postgres
# gestionado (postgresql://usuario:clave@host/basedatos).
DATABASE_URL=

# --- Cotizaciones ----------------------------------------------------------
# Por defecto se usan las de Yahoo Finance, que no piden registro. Rellenar
# esta clave sólo si se prefiere Finnhub (https://finnhub.io/register), que es
# lo recomendable en producción: Yahoo no ofrece un endpoint público con
# condiciones de uso para esto.
FINNHUB_API_KEY=

# Minutos que se reutiliza una cotización antes de volver a pedirla.
PRICE_CACHE_MINUTES=15

# Segundos entre llamadas al proveedor de precios. Yahoo responde 429 si se
# le piden varios símbolos seguidos sin pausa.
PRICE_REQUEST_PAUSE=1.0

# Divisa en la que se valora el patrimonio. Las posiciones que cotizan en otra
# se convierten al tipo de cambio del día (par de Yahoo, p. ej. EURUSD=X).
WEALTH_CURRENCY=USD

# Horas a partir de las cuales una cotización cacheada se marca como vieja en
# la ficha. El refresco programado corre cada seis.
PRICE_STALE_HOURS=24

# --- Ingesta ---------------------------------------------------------------
# Polling de fuentes oficiales. Sólo funciona donde hay un proceso vivo: en
# serverless se ignora y la ingesta se lanza desde fuera.
ENABLE_POLLING=1
POLL_INTERVAL_SECONDS=900

# --- Administración --------------------------------------------------------
# Abre los endpoints que escriben en la base o salen a la red
# (/api/poll-sources, /api/load-sample-filing). Sin esta variable esas rutas
# responden 404 y no hay forma de llamarlas: es el valor correcto en un
# despliegue público. Se manda en la cabecera X-Admin-Token.
ADMIN_TOKEN=

# Peticiones por IP: a la API pública por minuto, y a las rutas de
# administración cada diez minutos. Pasado el cupo responden 429.
RATE_LIMIT_API=120
RATE_LIMIT_ADMIN=5

# --- Registro --------------------------------------------------------------
LOG_LEVEL=INFO

# Copiar a .env y rellenar. El fichero .env no se sube al repositorio.

# Cotizaciones para valorar las posiciones de los directivos.
# Clave gratuita en https://finnhub.io/register (60 peticiones/minuto).
# Sin ella la web funciona, pero las posiciones salen sin valorar.
FINNHUB_API_KEY=

# Minutos que se reutiliza una cotización antes de volver a pedirla.
PRICE_CACHE_MINUTES=15

# Polling de fuentes oficiales.
ENABLE_POLLING=1
POLL_INTERVAL_SECONDS=900

# Copiar a .env y rellenar. El fichero .env no se sube al repositorio.

# Base de datos. Sin esto se usa el SQLite del directorio del proyecto, que
# sirve en local pero no en un despliegue serverless: allí hay que apuntar a un
# Postgres gestionado (postgresql://usuario:clave@host/basedatos).
DATABASE_URL=

# Cotizaciones: por defecto se usan las de Yahoo Finance, que no piden registro.
# Rellenar esta clave sólo si se prefiere Finnhub (https://finnhub.io/register).
FINNHUB_API_KEY=

# Minutos que se reutiliza una cotización antes de volver a pedirla.
PRICE_CACHE_MINUTES=15

# Segundos entre llamadas al proveedor de precios. Yahoo responde 429 si se
# le piden varios símbolos seguidos sin pausa.
PRICE_REQUEST_PAUSE=1.0

# Polling de fuentes oficiales.
ENABLE_POLLING=1
POLL_INTERVAL_SECONDS=900
